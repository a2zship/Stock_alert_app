# Cổng theo QUY_UOC_CONG_DU_AN.md — block 3270–3279
PORT=3271
DB_PORT=3273
HOST=127.0.0.1
# Số ngày giữ phiên đăng nhập
SESSION_DAYS=14
# Địa chỉ công khai (HTTPS) — dùng để in vào mã QR. Để trống thì lấy http://localhost:PORT
PUBLIC_URL=
# 1 = bật "Hộp tin thử nghiệm" công khai ở /thu-nghiem (hiện OTP, SMS lẽ ra được gửi). TẮT khi chạy thật.
DEV_INBOX=1
# Đón hộ có phí: phí nền tảng trích từ thu nhập người đón (0.1 = 10%) và tài khoản nhận phí (VietQR).
# [CẦN XÁC MINH] pháp lý + thuế trước khi thu thật. Để trống tài khoản → trang nộp phí báo "chưa cấu hình".
PLATFORM_FEE_RATE=0.1
PLATFORM_BANK_BIN=
PLATFORM_BANK_ACCOUNT=
PLATFORM_ACCOUNT_NAME=
# APP_SECRET được `npm run setup` tự sinh; không chia sẻ

POSTGRES_USER=donho
POSTGRES_PASSWORD=donho_local
DATABASE_URL=postgresql://donho:donho_local@localhost:3273/donho
DATABASE_URL_TEST=postgresql://donho:donho_local@localhost:3273/donho_test
# Số điện thoại quản trị nền tảng (cách nhau dấu phẩy): màn chuyển chia sẻ doanh thu /quan-tri/chia-se
ADMIN_PHONES=0908000000
