{
  "name": "donho",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "node scripts/next.mjs dev",
    "build": "next build",
    "start": "node scripts/next.mjs start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "db:up": "docker compose up -d --wait",
    "db:push": "prisma db push --skip-generate && prisma generate",
    "db:seed": "tsx prisma/seed.ts --if-empty",
    "db:reset": "prisma db push --force-reset --skip-generate && prisma generate && tsx prisma/seed.ts",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:int": "vitest run --project integration",
    "contrast": "node scripts/contrast.mjs"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "leaflet": "^1.9.4",
    "next": "^15.5.26",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@types/leaflet": "^1.9.12",
    "@types/node": "^22.20.4",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.26",
    "prisma": "^6.19.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "esbuild@0.28.2": true,
    "unrs-resolver@1.12.2": true,
    "prisma@6.19.3": true
  }
}
