# Copy thành deploy/.env trên máy chủ rồi điền. KHÔNG commit file .env.

# Tên miền đã trỏ (bản ghi A) về IP máy chủ, ví dụ demo.donho.vn
DOMAIN=

# Sinh ngẫu nhiên: openssl rand -hex 24  (mật khẩu DB)  /  openssl rand -hex 32  (APP_SECRET)
POSTGRES_PASSWORD=
APP_SECRET=

# ── Chế độ chạy ──
# Bản DEMO công khai (chỉ dữ liệu mẫu): SEED_DEMO=1, DEV_INBOX=1 — mã đăng nhập hiện công khai ở /thu-nghiem.
# Chạy THẬT cho trường: SEED_DEMO=0, DEV_INBOX=0 — CHỈ sau khi đã nối nhà cung cấp SMS/Zalo ZNS (xem hướng dẫn).
SEED_DEMO=1
DEV_INBOX=1

SESSION_DAYS=14

# Đón hộ có phí + thành viên ưu đãi: tài khoản nền tảng nhận tiền (VietQR). Để trống → trang thu tiền báo "chưa cấu hình".
PLATFORM_FEE_RATE=0.1
PLATFORM_BANK_BIN=
PLATFORM_BANK_ACCOUNT=
PLATFORM_ACCOUNT_NAME=
