// Đón Hộ — xem ../DacTa_UngDung_DonHo_27-10-2026.md. Mọi thời gian lưu UTC, hiển thị giờ Việt Nam.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Đơn vị hành chính: chính quyền 2 cấp từ 01/07/2025 (34 tỉnh/thành → xã/phường/đặc khu) ──

enum ProvinceKind {
  TINH
  THANH_PHO
}

model Province {
  id         Int          @id @default(autoincrement())
  code       String       @unique // mã viết tắt nội bộ, chờ đối chiếu mã chính thức
  name       String
  kind       ProvinceKind
  formedFrom String       @default("") // các tỉnh cũ hợp thành (để người dùng dễ nhận ra)
  wards      Ward[]
  residents  User[]
}

model Ward {
  id         Int      @id @default(autoincrement())
  provinceId Int
  province   Province @relation(fields: [provinceId], references: [id])
  name       String
  verified   Boolean  @default(true) // false = phụ huynh tự gõ khi đăng ký, chờ quản trị đối chiếu
  schools    School[]
  residents  User[]

  @@unique([provinceId, name])
}

model School {
  id         String          @id @default(cuid())
  wardId     Int
  ward       Ward            @relation(fields: [wardId], references: [id])
  name       String
  allowAdhoc Boolean         @default(true) // cho phép người đón ngoài danh sách tin cậy
  // Trường tự mở trên app: chưa xác minh tới khi quản trị nền tảng gọi xác minh — chưa mở đón có phí, chưa chuyển chia sẻ
  verified    Boolean  @default(true)
  createdAt   DateTime @default(now())
  createdById String?
  address    String          @default("")
  lat        Float? // toạ độ cổng trường, để vẽ bản đồ theo dõi
  lng        Float?
  classes    Class[]
  admins     SchoolAdmin[]
  helpers    HelperProfile[]
  residents  User[]

  // Chia sẻ doanh thu: tài khoản nhận của trường; trường tắt phần của cô thì phần đó gộp về trường
  teacherShare Boolean      @default(true)
  payBin       String?
  payAccount   String?
  payName      String?
  shares       ShareEntry[]
  payouts      Payout[]
}

model Class {
  id          String              @id @default(cuid())
  schoolId    String
  school      School              @relation(fields: [schoolId], references: [id])
  name        String
  pickupStart String // "HH:MM" giờ Việt Nam
  pickupEnd   String
  createdAt   DateTime            @default(now())
  students    Student[]
  teachers    TeacherAssignment[]
  posts       ChatPost[]
  claims      GuardianClaim[]
}

// ── Người dùng & vai trò ──

model User {
  id        String   @id @default(cuid())
  phone     String   @unique // dạng chuẩn 0xxxxxxxxx
  name      String
  createdAt DateTime @default(now())

  // Khu vực thực tế (chọn khi đăng ký): app hiển thị theo tỉnh → phường/xã → trường này
  provinceId    Int?
  province      Province? @relation(fields: [provinceId], references: [id])
  wardId        Int?
  ward          Ward?     @relation(fields: [wardId], references: [id])
  schoolId      String?
  school        School?   @relation(fields: [schoolId], references: [id])
  pendingSchool String? // trường chưa có trong hệ thống — phụ huynh ghi tên để đề xuất

  guardianOf    Guardian[]
  claims        GuardianClaim[]
  teaches       TeacherAssignment[]
  adminOf       SchoolAdmin[]
  requested     PickupRequest[]     @relation("requester")
  delegated     PickupRequest[]     @relation("delegate")
  chatPosts     ChatPost[]
  chatOffers    ChatOffer[]
  places        SavedPlace[]
  helper        HelperProfile?
  settlements   Settlement[]
  memberships   Membership[]
  monthlyAsked  MonthlyContract[]   @relation("monthlyRequester")
  monthlyHelped MonthlyContract[]   @relation("monthlyHelper")
  monthlyOffers MonthlyOffer[]

  // Giới thiệu bạn bè: mã của mình, người đã giới thiệu mình (tính thưởng 12 tháng từ referredAt)
  refCode      String?        @unique
  referredById String?
  referredBy   User?          @relation("referrals", fields: [referredById], references: [id])
  referrals    User[]         @relation("referrals")
  referredAt   DateTime?
  shares       ShareEntry[]   @relation("shareBeneficiary")
  creditUses   CreditUse[]
  payAccount   PayoutAccount?
  payouts      Payout[]
}

model Guardian {
  userId    String
  user      User    @relation(fields: [userId], references: [id])
  studentId String
  student   Student @relation(fields: [studentId], references: [id])
  relation  String // Bố, Mẹ, Người giám hộ

  @@id([userId, studentId])
}

// Phụ huynh tự đăng ký xin nhận là phụ huynh của bé: cô lớp gọi xác minh rồi mới gắn với hồ sơ bé.
enum ClaimStatus {
  CHO_DUYET
  DA_DUYET
  TU_CHOI
}

model GuardianClaim {
  id           String      @id @default(cuid())
  userId       String
  user         User        @relation(fields: [userId], references: [id])
  classId      String
  class        Class       @relation(fields: [classId], references: [id])
  studentName  String
  relation     String
  status       ClaimStatus @default(CHO_DUYET)
  studentId    String? // bé được gắn khi duyệt (có sẵn trong lớp hoặc cô thêm mới)
  decidedById  String?
  decidedAt    DateTime?
  calledParent Boolean     @default(false)
  note         String      @default("")
  createdAt    DateTime    @default(now())

  @@index([classId, status])
}

model TeacherAssignment {
  userId  String
  user    User   @relation(fields: [userId], references: [id])
  classId String
  class   Class  @relation(fields: [classId], references: [id])

  @@id([userId, classId])
}

model SchoolAdmin {
  userId   String
  user     User   @relation(fields: [userId], references: [id])
  schoolId String
  school   School @relation(fields: [schoolId], references: [id])

  @@id([userId, schoolId])
}

model Student {
  id        String            @id @default(cuid())
  classId   String
  class     Class             @relation(fields: [classId], references: [id])
  name      String
  photoId   String?
  guardians Guardian[]
  trusted   TrustedPerson[]
  blocked   BlockedPerson[]
  requests  PickupRequest[]
  posts     ChatPost[]
  monthly   MonthlyContract[]
}

// ── Người tin cậy & người không được đón ──

enum TrustStatus {
  CHO_DUYET
  DA_DUYET
  TU_CHOI
  DA_XOA
}

model TrustedPerson {
  id           String      @id @default(cuid())
  studentId    String
  student      Student     @relation(fields: [studentId], references: [id])
  addedById    String
  name         String
  phone        String
  relation     String
  cccdLast4    String // chỉ lưu 4 số cuối CCCD
  photoId      String
  status       TrustStatus @default(CHO_DUYET)
  reviewedById String?
  reviewedAt   DateTime?
  reviewNote   String?
  createdAt    DateTime    @default(now())

  @@index([studentId, status])
}

model BlockedPerson {
  id        String   @id @default(cuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id])
  addedById String
  name      String
  phone     String?
  note      String   @default("")
  createdAt DateTime @default(now())
}

// ── Yêu cầu đón hộ ──

enum RequestStatus {
  CHO_NGUOI_DON
  CHO_GIAO_VIEN
  DA_DUYET
  BI_KHOA
  DA_GIAO
  HOAN_TAT
  NGUOI_DON_TU_CHOI
  GV_TU_CHOI
  DA_HUY
  HET_HAN
  KHONG_GIAO_DUOC
}

model PickupRequest {
  id              String        @id @default(cuid())
  studentId       String
  student         Student       @relation(fields: [studentId], references: [id])
  requesterId     String
  requester       User          @relation("requester", fields: [requesterId], references: [id])
  delegateId      String
  delegate        User          @relation("delegate", fields: [delegateId], references: [id])
  trustedPersonId String?
  isAdhoc         Boolean
  delegateName    String
  delegatePhone   String
  relation        String
  cccdLast4       String? // người ngoài danh sách tự khai khi nhận lời
  delegatePhotoId String?
  reason          String        @default("")
  windowStart     DateTime
  windowEnd       DateTime
  status          RequestStatus @default(CHO_NGUOI_DON)

  // mã đón một lần — chỉ lưu bản băm
  tokenHash   String? @unique
  pinHash     String?
  codeSealed  String? // token + PIN mã hoá AES-GCM, chỉ để hiện lại cho người đón
  pinAttempts Int     @default(0)

  teacherCalledParent Boolean   @default(false)
  decidedById         String?
  decidedAt           DateTime?
  decisionNote        String?

  gateVerifiedById String?
  gateVerifiedAt   DateTime?
  handedOverById   String?
  handedOverAt     DateTime?
  handoverPhotoId  String?
  failReason       String?
  closedAt         DateTime?
  autoClosed       Boolean   @default(false)

  // theo dõi trên bản đồ — chỉ giữ ĐIỂM MỚI NHẤT (không lưu lộ trình), xoá khi yêu cầu đóng
  delegateLat   Float?
  delegateLng   Float?
  delegateLocAt DateTime?
  arrivedAt     DateTime? // người đón bấm "Tôi đã tới cổng"
  thanks        String? // lời cảm ơn của phụ huynh khi xác nhận bé về

  // điểm trả bé — phụ huynh khai THEO TỪNG LẦN (không lưu địa chỉ vào hồ sơ trẻ), xoá khi yêu cầu đóng.
  // Phường/xã giữ lại để hiện trong nhóm lớp; số nhà/đường + toạ độ chỉ phụ huynh, GV lớp, người đón đã được duyệt thấy.
  dropLabel   String? // "Nhà", "Nhà bà ngoại"…
  dropAddress String?
  dropWard    String?
  dropLat     Float?
  dropLng     Float?
  droppedAt   DateTime? // người đón bấm "Đã đưa bé tới nơi"

  // đón hộ có phí — phụ huynh cùng trường đã được duyệt. App KHÔNG giữ tiền: người nhờ chuyển khoản VietQR thẳng cho người đón.
  fee           Int? // thù lao TỐI THIỂU (đồng) người nhờ cam kết; trả khi bé về an toàn
  paidAmount    Int? // số người nhờ thực chuyển (≥ fee, tự chọn kèm lời cảm ơn)
  commission    Int? // phí nền tảng trích từ thu nhập người đón, tính lại theo paidAmount khi trả
  paidAt        DateTime? // người nhờ bấm "Tôi đã chuyển khoản"
  receivedAt    DateTime? // người đón bấm "Đã nhận tiền"
  payRemindedAt DateTime?
  settlementId  String?
  settlement    Settlement? @relation(fields: [settlementId], references: [id])

  // buổi đón sinh ra từ hợp đồng tháng — đã duyệt sẵn, không có thù lao riêng (đã trả trọn gói)
  contractId String?
  contract   MonthlyContract? @relation(fields: [contractId], references: [id])

  createdAt DateTime       @default(now())
  events    RequestEvent[]

  @@index([studentId, status])
  @@index([delegateId, status])
  @@index([status, windowEnd])
}

// Nhật ký chỉ thêm, không sửa/xoá
model RequestEvent {
  id         String         @id @default(cuid())
  requestId  String
  request    PickupRequest  @relation(fields: [requestId], references: [id])
  actorId    String? // null = hệ thống
  actorRole  String // PHU_HUYNH | NGUOI_DON | GIAO_VIEN | HE_THONG
  action     String
  fromStatus RequestStatus?
  toStatus   RequestStatus?
  note       String         @default("")
  at         DateTime       @default(now())

  @@index([requestId, at])
}

model AuditLog {
  id      String   @id @default(cuid())
  actorId String?
  action  String
  target  String   @default("")
  meta    Json?
  at      DateTime @default(now())
}

// ── Ảnh (lưu trong DB để mọi lần xem đều qua kiểm quyền) ──

enum PhotoKind {
  CHAN_DUNG
  BAN_GIAO
  TRE
}

model Photo {
  id        String    @id @default(cuid())
  kind      PhotoKind
  mime      String
  bytes     Bytes
  ownerId   String?
  createdAt DateTime  @default(now())
}

// ── Đăng nhập OTP & hộp tin thử nghiệm ──

model OtpCode {
  id        String    @id @default(cuid())
  phone     String
  codeHash  String
  expiresAt DateTime
  attempts  Int       @default(0)
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([phone, createdAt])
}

enum Channel {
  SMS
  PUSH
}

model Message {
  id        String    @id @default(cuid())
  toPhone   String
  toUserId  String?
  channel   Channel
  body      String
  link      String?
  createdAt DateTime  @default(now())
  readAt    DateTime?

  @@index([toUserId, createdAt])
}

// ── Nhóm chat của lớp: phụ huynh + giáo viên; phụ huynh đăng lời nhờ đón, phụ huynh khác nhận giúp ──

enum PostKind {
  TIN_NHAN
  NHO_DON
}

enum PostStatus {
  MO // đang tìm người
  DA_CHON // đã chọn người, đã tạo yêu cầu đón hộ
  DA_DONG // người đăng tự đóng
}

enum AskScope {
  LOP
  TRUONG
  KHU_VUC
}

model ChatPost {
  id          String      @id @default(cuid())
  classId     String
  class       Class       @relation(fields: [classId], references: [id])
  authorId    String
  author      User        @relation(fields: [authorId], references: [id])
  kind        PostKind
  body        String
  studentId   String? // chỉ với NHO_DON
  student     Student?    @relation(fields: [studentId], references: [id])
  date        String? // YYYY-MM-DD, chỉ với NHO_DON
  status      PostStatus  @default(MO)
  requestId   String? // yêu cầu đón hộ tạo ra khi chọn người
  // điểm trả: cả nhóm chỉ thấy phường/xã; địa chỉ chi tiết chuyển sang yêu cầu khi chọn người rồi xoá khỏi bài đăng
  dropLabel   String?
  dropAddress String?
  dropWard    String?
  dropLat     Float?
  dropLng     Float?
  fee         Int? // > 0: lời nhờ có thù lao tối thiểu — người đón có phí đã duyệt của trường nhận được (từ vòng TRƯỜNG)
  // vòng phát lời nhờ (domain/ask.ts): LOP → TRUONG → KHU_VUC, chỉ lên vòng sau khi chưa ai nhận
  scope       AskScope    @default(LOP)
  scopeAt     DateTime    @default(now()) // lúc vào vòng hiện tại
  areaWardId  Int? // phường/xã nơi người nhờ sống — phạm vi vòng KHU_VUC
  createdAt   DateTime    @default(now())
  offers      ChatOffer[]

  @@index([classId, createdAt])
  @@index([kind, status, scope])
}

model ChatOffer {
  id        String   @id @default(cuid())
  postId    String
  post      ChatPost @relation(fields: [postId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  note      String   @default("")
  createdAt DateTime @default(now())

  @@unique([postId, userId])
}

/// Điểm trả hay dùng của PHỤ HUYNH (Nhà, Nhà bà ngoại…) — chỉ để điền nhanh, gắn với tài khoản phụ huynh, không gắn hồ sơ trẻ.
model SavedPlace {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label     String
  address   String
  ward      String
  lat       Float?
  lng       Float?
  createdAt DateTime @default(now())

  @@unique([userId, label])
}

enum HelperStatus {
  CHO_DUYET
  DA_DUYET
  TU_CHOI
  TAM_DUNG
}

/// Phụ huynh đăng ký nhận đón hộ có phí trong trường của con mình. Giáo viên lớp của con họ duyệt một lần.
model HelperProfile {
  id           String       @id @default(cuid())
  userId       String       @unique
  user         User         @relation(fields: [userId], references: [id])
  schoolId     String
  school       School       @relation(fields: [schoolId], references: [id])
  cccdLast4    String
  photoId      String
  bankBin      String // mã ngân hàng NAPAS (6 số) để tạo VietQR
  bankAccount  String
  accountName  String // tên chủ tài khoản, IN HOA không dấu
  status       HelperStatus @default(CHO_DUYET)
  note         String?
  reviewedById String?
  reviewedAt   DateTime?
  createdAt    DateTime     @default(now())
}

/// Một lần người đón nộp phí nền tảng (gộp nhiều lượt đón).
model Settlement {
  id               String            @id @default(cuid())
  userId           String
  user             User              @relation(fields: [userId], references: [id])
  amount           Int
  creditUsed       Int               @default(0) // trừ bằng tín dụng giới thiệu; tiền mặt = amount − creditUsed
  createdAt        DateTime          @default(now())
  requests         PickupRequest[]
  monthlyContracts MonthlyContract[]
}

enum MemberTier {
  BAC
  VANG
  KIM_CUONG
}

enum MembershipStatus {
  CHO_DOI_SOAT // phụ huynh báo đã chuyển khoản — có hiệu lực ngay, chờ nền tảng đối soát sao kê
  DA_XAC_NHAN
  HUY // đối soát không thấy tiền → huỷ, mất hiệu lực
}

/// Gói thành viên ưu đãi đã mua (Thường = không có gói). Hạng đang có = gói còn hạn cao nhất.
model Membership {
  id         String           @id @default(cuid())
  userId     String
  user       User             @relation(fields: [userId], references: [id])
  tier       MemberTier
  months     Int
  amount     Int
  creditUsed Int              @default(0) // trừ bằng tín dụng giới thiệu
  startsAt   DateTime
  endsAt     DateTime
  status     MembershipStatus @default(CHO_DOI_SOAT)
  createdAt  DateTime         @default(now())

  @@index([userId, endsAt])
}

// ── Đón theo tháng: một người đón cố định cho các buổi trong tháng, trả TRỌN GÓI ĐẦU THÁNG thẳng cho người đón ──

enum MonthlyStatus {
  TIM_NGUOI // hợp đồng mở trên bảng việc của trường (24 giờ đầu chỉ Kim cương)
  CHO_NGUOI_DON // phụ huynh chỉ định người đón, chờ người đó nhận lời
  CHO_GIAO_VIEN // đã có người đón, chờ cô duyệt một lần
  DA_DUYET // đang chạy: mỗi buổi tự sinh yêu cầu đã duyệt (mã QR/PIN mới)
  TU_CHOI // người đón hoặc cô từ chối
  DA_HUY // phụ huynh huỷ trước khi duyệt
  KET_THUC // hết tháng hoặc một bên dừng sớm
}

model MonthlyContract {
  id            String        @id @default(cuid())
  studentId     String
  student       Student       @relation(fields: [studentId], references: [id])
  requesterId   String
  requester     User          @relation("monthlyRequester", fields: [requesterId], references: [id])
  helperId      String?
  helper        User?         @relation("monthlyHelper", fields: [helperId], references: [id])
  designated    Boolean // phụ huynh chỉ định người đón
  month         String // YYYY-MM
  weekdays      Int[] // 1 = Thứ Hai … 6 = Thứ Bảy
  firstDay      String // YYYY-MM-DD: buổi sớm nhất (tháng hiện tại thì từ ngày mai)
  fee           Int // trọn gói cả tháng
  note          String        @default("")
  status        MonthlyStatus
  priorityUntil DateTime? // hợp đồng mở: trước mốc này chỉ người đón Kim cương nhận được

  // điểm trả cố định cả tháng — xoá khi kết thúc
  dropLabel   String?
  dropAddress String?
  dropWard    String?
  dropLat     Float?
  dropLng     Float?

  decidedById         String?
  decidedAt           DateTime?
  decisionNote        String?
  teacherCalledParent Boolean   @default(false)

  skipDates String[] // buổi phụ huynh tự huỷ — không hoàn tiền
  missDates String[] // buổi người đón báo nghỉ — hoàn tiền

  paidAt       DateTime?
  paidAmount   Int?
  rate         Float? // phí nền tảng chốt lúc trả (theo hạng hai bên)
  commission   Int?
  receivedAt   DateTime?
  settlementId String?
  settlement   Settlement? @relation(fields: [settlementId], references: [id])

  endedAt    DateTime?
  endedBy    String? // PHU_HUYNH | NGUOI_DON | HE_THONG
  endDate    String? // buổi cuối cùng còn đón (YYYY-MM-DD)
  endReason  String?
  refundDue  Int? // người đón phải hoàn lại cho phụ huynh
  refundedAt DateTime?

  createdAt DateTime        @default(now())
  offers    MonthlyOffer[]
  requests  PickupRequest[]

  @@index([status, month])
  @@index([helperId, status])
}

model MonthlyOffer {
  id         String          @id @default(cuid())
  contractId String
  contract   MonthlyContract @relation(fields: [contractId], references: [id])
  userId     String
  user       User            @relation(fields: [userId], references: [id])
  createdAt  DateTime        @default(now())

  @@unique([contractId, userId])
}

// ── Giới thiệu bạn bè & chia sẻ doanh thu với nhà trường, giáo viên (domain/share.ts) ──
// Chỉ chia trên TIỀN MẶT nền tảng thực thu (phí nền tảng người đón nộp, phí thành viên) — phần trả bằng tín dụng không chia.

enum ShareKind {
  GIOI_THIEU // người giới thiệu — tín dụng trừ phí, không rút tiền mặt
  TRUONG
  GIAO_VIEN
}

enum ShareSource {
  THANH_VIEN
  PHI_NEN_TANG
}

enum ShareStatus {
  TAM_TINH // chờ hết tháng + đối soát
  DA_TRA // nền tảng đã chuyển (trường/cô)
  HUY // nguồn doanh thu bị huỷ khi đối soát
}

model ShareEntry {
  id         String      @id @default(cuid())
  kind       ShareKind
  userId     String? // người giới thiệu / giáo viên
  user       User?       @relation("shareBeneficiary", fields: [userId], references: [id])
  schoolId   String? // trường (phần TRUONG) hoặc trường của lớp (phần GIAO_VIEN)
  school     School?     @relation(fields: [schoolId], references: [id])
  classId    String?
  source     ShareSource
  sourceId   String // id gói thành viên / lần nộp phí
  fromUserId String // người phát sinh doanh thu
  base       Int // tiền mặt nền tảng thu được tính cho dòng này
  rate       Float
  amount     Int
  month      String // YYYY-MM (giờ Việt Nam) lúc phát sinh
  status     ShareStatus @default(TAM_TINH)
  payoutId   String?
  payout     Payout?     @relation(fields: [payoutId], references: [id])
  createdAt  DateTime    @default(now())

  @@index([userId, kind, status])
  @@index([schoolId, kind, month])
  @@index([sourceId])
}

/// Một lần nền tảng chuyển tiền chia sẻ cho trường hoặc một giáo viên (gộp theo tháng).
model Payout {
  id       String       @id @default(cuid())
  kind     ShareKind
  userId   String?
  user     User?        @relation(fields: [userId], references: [id])
  schoolId String?
  school   School?      @relation(fields: [schoolId], references: [id])
  month    String
  amount   Int
  bank     String // ảnh chụp tài khoản nhận lúc chuyển
  paidById String
  paidAt   DateTime     @default(now())
  entries  ShareEntry[]
}

/// Tín dụng giới thiệu đã dùng để trừ phí thành viên / phí nền tảng.
model CreditUse {
  id        String      @id @default(cuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id])
  amount    Int
  purpose   ShareSource
  refId     String
  createdAt DateTime    @default(now())

  @@index([userId])
}

/// Tài khoản ngân hàng giáo viên nhận phần chia sẻ (đứng tên chính mình).
model PayoutAccount {
  userId      String   @id
  user        User     @relation(fields: [userId], references: [id])
  bankBin     String
  bankAccount String
  accountName String
  updatedAt   DateTime @updatedAt
}

// Nhắc việc tự động trong phễu mở trường (mỗi loại × đối tượng: tối đa 3 lần, cách nhau ≥ 7 ngày)
model Nudge {
  id     String   @id @default(cuid())
  kind   String
  target String
  sentAt DateTime @default(now())

  @@index([kind, target])
}
