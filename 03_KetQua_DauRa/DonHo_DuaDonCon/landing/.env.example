# Cổng dev/preview (scaffold.py tự ghi). Nếu workspace có sổ quy ước cổng thì đăng ký ở đó trước.
DEV_PORT=3275
PREVIEW_PORT=3276

# Link CSV của trang tính dữ liệu đã "Công bố lên web" (xem docs/HuongDan_CapNhat_HangNgay.md).
# Để trống → trang dùng dữ liệu mẫu và hiện nhãn "Dữ liệu mẫu".
VITE_SHEET_CSV_URL=

# Địa chỉ app Đón Hộ: nút "Đăng ký", "Mở trường", "Đăng nhập" dẫn về đây. Đổi sang tên miền thật trước khi build bản đưa lên mạng.
VITE_APP_URL=http://localhost:3271
